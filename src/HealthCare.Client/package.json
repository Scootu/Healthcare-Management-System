    "react-dom": "^19.1.0",
    "react-hook-form": "^7.62.0",
    "react-pro-sidebar": "^1.1.0",
    "react-router-dom": "^7.7.0",
    "react-window": "^2.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
